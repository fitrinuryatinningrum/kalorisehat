rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAllowed() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/allowlist/$(request.auth.uid));
    }

    match /users/{userId}/{allPaths=**} {
      allow read, write: if isAllowed() && request.auth.uid == userId;
    }
  }
}
